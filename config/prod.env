FAA_SECURITY_SPEC=FAA-SEC-02
PENNY_DROP_VERIFICATION_ENABLED=true
AUTO_FETCH_IFSC_BRANCH_ENABLED=true

# KYC Verification & ID Proof
KYC_API_URL=https://finmos-user.onrender.com/api/v1/kyc
KYC_STATUS_URL=https://finmos-user.onrender.com/api/v1/kyc/status
KYC_DOCUMENTS_URL=https://finmos-user.onrender.com/api/v1/kyc/documents
