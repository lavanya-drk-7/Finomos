# Bank Aggregation & Account Aggregator (FAA Framework)
BANK_AGGREGATION_API_URL=https://finmos-user.onrender.com/api/v1/bank-aggregation
BANK_AGGREGATION_SUMMARY_URL=https://finmos-user.onrender.com/api/v1/bank-aggregation/summary
