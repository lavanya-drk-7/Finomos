# ==============================================================================
# FINOMOS PRODUCTION ENVIRONMENT CONFIGURATION (prod.env)
# ==============================================================================
# Environment: Production
# Created: 2026-11-06
# Base Backend URL: https://finmos-user.onrender.com
# ==============================================================================

# Application Environment
ENV=production
APP_ENV=production
NODE_ENV=production
DEBUG=false
ENABLE_MOCK_DATA=false

# Core App Details
APP_NAME=Finomos
APP_TITLE=FINOMOS - AI Personal CFO
APP_VERSION=1.0.0+1
APP_BUNDLE_ID=com.finomos
APP_SCHEME=finomos

# Primary Backend API Endpoints
API_BASE_URL=https://finmos-user.onrender.com
BASE_URL=https://finmos-user.onrender.com
BACKEND_URL=https://finmos-user.onrender.com
API_VERSION=v1
API_TIMEOUT_MS=30000

# Authentication & Session
AUTH_API_BASE=https://finmos-user.onrender.com/api/v1/auth
AUTH_LOGIN_URL=https://finmos-user.onrender.com/api/v1/auth/login
AUTH_SEND_OTP_URL=https://finmos-user.onrender.com/api/v1/auth/send-otp
AUTH_VERIFY_OTP_URL=https://finmos-user.onrender.com/api/v1/auth/verify-otp
AUTH_REFRESH_TOKEN_URL=https://finmos-user.onrender.com/api/auth/refresh-token
AUTH_LOGOUT_URL=https://finmos-user.onrender.com/api/auth/logout
SESSION_TIMEOUT_MINUTES=15
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PIN_LOCK=true

# Notification & SMS Detection API
NOTIFICATIONS_API_URL=https://finmos-user.onrender.com/api/v1/notifications
NOTIFICATIONS_UNREAD_COUNT_URL=https://finmos-user.onrender.com/api/v1/notifications/unread-count
NOTIFICATIONS_READ_ALL_URL=https://finmos-user.onrender.com/api/v1/notifications/read-all
SMS_SYNC_BATCH_URL=https://finmos-user.onrender.com/api/v1/notifications/sms/batch-sync
SMS_INGEST_URL=https://finmos-user.onrender.com/api/v1/notifications/sms/ingest
SMS_AUTO_DETECTION_ENABLED=true
SMS_SYNC_MODE=HISTORICAL
SMS_HISTORICAL_SYNC_LIMIT=50

# Income Tracking Module
INCOME_API_URL=https://finmos-user.onrender.com/api/v1/income
INCOME_SUMMARY_URL=https://finmos-user.onrender.com/api/v1/income/summary
